load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "command_dispatcher",
    srcs = ["command_dispatcher.cc"],
    hdrs = ["command_dispatcher.h"],
    deps = [
        "//openfst/compat:file_path",
        "//openfst/compat:init",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/flags:reflection",
        "@com_google_absl//absl/flags:usage",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/strings",
    ],
)

# Default extensions which are linked statically with the binaries.
cc_library(
    name = "extensions",
    linkstatic = 1,
    deps = [
        "//openfst/extensions/lookahead:olabel_lookahead-fst",
        "//openfst/extensions/ngram:ngram-fst-file",
    ],
    alwayslink = 1,
)

FAR_TOOLS = [
    "farcompilestrings",
    "farconvert",
    "farcreate",
    "farencode",
    "farequal",
    "farextract",
    "farinfo",
    "farisomorphic",
    "farprintstrings",
]

# If you want to create a lightweight custom `far` binary, define a `cc_binary` that depends on this
# target and add specific extensions and //file types to the `deps` list.
cc_library(
    name = "far_main",
    srcs = ["far.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":command_dispatcher",
        "//openfst/compat:file_path",
        "//openfst/lib",
        "@com_google_absl//absl/flags:flag",
    ] + ["//openfst/extensions/far:%s-main" % t for t in FAR_TOOLS],
)

# If the default file factories are too heavy, use a custom binary with
# `:far_main`.
cc_binary(
    name = "far",
    linkstatic = True,
    deps = [
        ":extensions",
        ":far_main",
        "//openfst/compat:file_path",
        "//openfst/lib",
    ],
)
